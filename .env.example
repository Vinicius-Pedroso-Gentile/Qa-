# Copie para .env e ajuste. O .env nao vai para o git.

# ---------- LLM local (Ollama) ----------
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=8192

# ---------- LangSmith (opcional) ----------
# Deixe false para rodar sem tracing. Chave em https://smith.langchain.com/settings
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=qai-poc
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- Servidor ----------
HOST=127.0.0.1
PORT=8000
# A tela do browser aparece dentro do chat. HEADLESS=false abre tambem a janela real
# do Chromium, se voce preferir mostrar o browser de verdade na apresentacao.
HEADLESS=true
